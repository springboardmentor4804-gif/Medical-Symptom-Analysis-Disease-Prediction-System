# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Secrets ----
# .env holds SECRET_KEY and the bootstrap admin password. install.bat generates
# it locally; it must never be committed. .env.example is the template.
.env
backend/.env
web/.env
*.pem
*.key

# ---- Runtime data ----
# The SQLite database contains real patient assessments.
*.db
*.sqlite
*.sqlite3
backend/medassist.db
backend/data/
backend/generated_reports/*.pdf
!backend/generated_reports/.gitkeep

# ---- Node / web build ----
node_modules/
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-error.log*

# ---- Training scratch ----
# The training notebook writes an artifacts/ directory next to itself when run
# locally. The copies the application loads live in backend/artifacts/.
#
# This pattern MUST be anchored with a leading slash. A bare `artifacts/`
# matches at every depth in git, so it would silently exclude
# backend/artifacts/ too and the repo would clone without the models the API
# needs to start.
/training/artifacts/
.kagglehub/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/

# NOTE: backend/artifacts/ is intentionally NOT ignored. Those 21 trained
# artifacts are what the API loads at runtime, so the repo is not deployable
# without them. The large ones are stored via Git LFS - see .gitattributes.

# Accidental Windows artifact: a script redirected to dev/null instead of
# /dev/null, creating stray git hooks here.
dev/null/
