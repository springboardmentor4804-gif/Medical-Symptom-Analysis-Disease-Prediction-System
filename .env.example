# Environment Variables Template for MedAssist AI Production & Containerized Deployment
# Copy this file to .env and configure real values before deploying

# --- BACKEND CONFIGURATION ---
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas Database Connection URI (Production Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/medi_ai_db?retryWrites=true&w=majority

# CORS Allowed Origins (Comma separated list or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5000

# Authentication & Secret Keys
JWT_SECRET=your-production-jwt-secret-key-change-this-in-prod

# --- FRONTEND CONFIGURATION ---
# Backend API Base URL consumed by Vite React build
VITE_API_URL=http://localhost:5000/api
