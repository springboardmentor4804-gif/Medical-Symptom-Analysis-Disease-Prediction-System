SECRET_KEY=replace-with-output-of-python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./medassist.db
# MUST list every origin the browser serves the UI from. 5173 is the React
# app (the primary UI) and 8501 is the legacy Streamlit one. Setting this
# variable REPLACES the default in config.py rather than adding to it, so
# dropping 5173 here silently breaks the web UI: the API answers normally
# and the browser discards every response as a CORS violation, which looks
# like a blank page rather than an error.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Creates one admin account on first startup if no admin exists yet. Leave unset to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@medassist.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
